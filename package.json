{
  "name": "rn-arch-agent",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "todo": "tsx apps/cli/src/main.ts",
    "test": "vitest run",
    "test:core": "vitest run --project core",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
