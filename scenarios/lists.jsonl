// Lists: create, delete (navigation is pruned), restore, and the protected Inbox.
{"run":"state.load","input":{"fixture":"demo"}}
{"expect":"list.list","length":2}
{"run":"list.create","input":{"name":"Work"},"save":"work"}
{"run":"list.create","input":{"name":"work"},"expectError":"conflict"}
{"run":"todo.create","input":{"listId":"$work.id","title":"Ship POC"}}
{"run":"nav.push","input":{"route":{"name":"list","params":{"listId":"$work.id"}}}}
{"run":"list.delete","input":{"id":"$work.id"},"save":"gone"}
{"expect":"app.inspect","path":"route.name","equals":"lists"}
{"expect":"list.list","length":2}
{"run":"list.restore","input":{"list":"$gone.deleted","todos":"$gone.todos"}}
{"expect":"todo.list","input":{"listId":"$work.id"},"length":1}
{"run":"list.delete","input":{"id":"inbox"},"expectError":"forbidden"}
{"run":"nav.reset","input":{"route":{"name":"list","params":{"listId":"groceries"}}}}
{"expect":"app.inspect","path":"viewModel.title","equals":"Groceries"}
{"expect":"state.get","path":"nav.stack","length":2}
